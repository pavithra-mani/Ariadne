# Copy to .env (never commit it). Every key is optional: without keys the app runs rule-based.
GEMINI_API_KEY=            # Google AI Studio key: drives the agents (triage, tool-using advisor, RAG grading, planning)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=20              # client-side requests/minute ceiling (free tier is limited; 429s are retried then fall back)
LLM_BUDGET_PER_REQUEST=40  # max LLM calls for one user request including the buyer incidents it opens
DISEASE_FALLBACK=          # set to "gemini" to let Gemini look at photos until your trained models are added
GROQ_API_KEY=              # optional: if set, Groq formats structured output instead of Gemini
GROQ_MODEL=llama-3.3-70b-versatile
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ariadne
JWT_SECRET=change-me-to-a-long-random-string
